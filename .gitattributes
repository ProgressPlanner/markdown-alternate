# Keep GitHub source archives (used by automatic updates) installable and clean.
# Keep exclusions in sync with .distignore for the attached release ZIP.
/.claude export-ignore
/.distignore export-ignore
/.env export-ignore
/.env.example export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.planning export-ignore
/bin export-ignore
/logs export-ignore
/tests export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpstan-baseline.neon export-ignore
/phpstan.neon.dist export-ignore
/vendor/**/.github export-ignore
/vendor/**/composer.json export-ignore
/vendor/**/phpstan.neon.dist export-ignore
